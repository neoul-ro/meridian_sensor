<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>meridian_sensor</name>
  <version>0.1.0</version>
  <description>Sensor driver launches for the Meridian robot: VLP-16 LiDAR, RealSense D435, VectorNav VN-100 (+ Meridian schema topics)</description>
  <maintainer email="151780134+juyoung020@users.noreply.github.com">juyoung020</maintainer>
  <license>MIT</license>

  <exec_depend>velodyne_driver</exec_depend>
  <exec_depend>velodyne_pointcloud</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>vectornav</exec_depend>
  <exec_depend>topic_tools</exec_depend>
  <exec_depend>depth_image_proc</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
